[Unit]
Description=Jf Pushover Webhook Quadlet

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target

[Container]
Image=ghcr.io/sudo-kraken/jf-pushover-webhook:latest
Pull=newer
ContainerName=jf-pushover-webhook
HostName=jf-pushover-webhook

PublishPort=127.0.0.1:8484:8484

HealthCmd=curl -fsS http://127.0.0.1:8484/health || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=10s
HealthRetries=3

EnvironmentFile=pushover-webhook.env
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
